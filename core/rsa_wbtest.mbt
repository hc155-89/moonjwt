  #|cvqcY8LWqeiyqQYRC2CEI082rGWRUXZRuC+d1Ws4+FlEqWrES/jM/mxg3YnYOI+b
  #|C1oWnD1V9mWONGFuc6RyUnFyCOH07XyKte9yhbcKm8VNJoZGAQn+QyYrdG54/sLj
  #|BkG3iq6yZkrN1ERuMI1aycfizuat9PNhDs4HzTQRACr82bX06FKn4kWXN4w+vtRk
  #|8QIDAQAB
  #|-----END PUBLIC KEY-----

///|
/// PKCS#1 public key (`openssl rsa -RSAPublicKey_out`).
const PKCS1_PUBLIC_PEM : String =
  #|-----BEGIN RSA PUBLIC KEY-----
  #|MIIBCgKCAQEAqcmrp+2H3lKzToMRhG4dcsgKjbRpIva3IEXJlzGvFPF1YGP+F2BK
  #|gSQoTC2e0FueDbtWbPP6NCsa0dQ7IVbZ8+GpJLJhJmhhgrI1485GH+NxaDn8NFok
  #|okfmdob6FB/yrJO9Pc4DRzwdQNOkQqhEcvqcY8LWqeiyqQYRC2CEI082rGWRUXZR
  #|uC+d1Ws4+FlEqWrES/jM/mxg3YnYOI+bC1oWnD1V9mWONGFuc6RyUnFyCOH07XyK
  #|te9yhbcKm8VNJoZGAQn+QyYrdG54/sLjBkG3iq6yZkrN1ERuMI1aycfizuat9PNh
  #|Ds4HzTQRACr82bX06FKn4kWXN4w+vtRk8QIDAQAB
  #|-----END RSA PUBLIC KEY-----

///|
/// Message used for the external OpenSSL signature vector.
const RSA_TEST_MESSAGE : String = "moonjwt-rs256-test-vector"

///|
/// Signature produced by `openssl dgst -sha256 -sign` over `RSA_TEST_MESSAGE`.
const RSA_TEST_SIGNATURE_B64URL : String = "hHJBMPPWLByP1Xj6yKqkHnS5Uek74g2QXYV6YW6oJ4mUrk41XV4oCiNTWfLp42klIShDI0OIhwk_EfMGCZZOlfTFORfPyeffT7FkYTFs8TkdGJlHV4_Vl0_4_A9VWuTWail_FMeZXCF6H6LUtgzIu6gkgjQwNKLDvnbbb_1Z0OAg5Zt8pkbfEnV0Mfgrjqo1taeK4ibHCbAfc0CxVLwMstBUX4gvzPayguG9xYr_Y_X5BVTwftOQtC3tyTdjbFn0gTigIln2cLyRup5E41Pj-KGzEvWaeQz_DlxFhp2glXHw44fo7iyKEgZv9I_PNgcs6MDS_E03uc6N-tOosAeT0A"

///|
test "rsa: pkcs1 private key signs and spki public key verifies" {
  let private_key = RsaPrivateKey::from_pem(PKCS1_PRIVATE_PEM)
  let public_key = RsaPublicKey::from_pem(SPKI_PUBLIC_PEM)
  assert_eq(private_key.modulus_bits(), 2048)
  let message = @utf8.encode(RSA_TEST_MESSAGE)
  let signature = private_key.sign_sha256(message)
  assert_eq(signature.length(), 256)
  assert_true(public_key.verify_sha256(message, signature))
  assert_true(
    !public_key.verify_sha256(
      @utf8.encode("moonjwt-rs256-test-vector!"),
      signature,
    ),
  )
}

///|
test "rsa: pkcs8 private key parses to the same key material" {
  let pkcs1 = RsaPrivateKey::from_pem(PKCS1_PRIVATE_PEM)
  let pkcs8 = RsaPrivateKey::from_pem(PKCS8_PRIVATE_PEM)
  let message = @utf8.encode(RSA_TEST_MESSAGE)
  assert_eq(pkcs1.sign_sha256(message), pkcs8.sign_sha256(message))
  assert_eq(pkcs1.modulus_bits(), pkcs8.modulus_bits())
}

///|
test "rsa: both public key encodings verify an external openssl signature" {
  let message = @utf8.encode(RSA_TEST_MESSAGE)
  let signature = decode_base64url(RSA_TEST_SIGNATURE_B64URL)
  let spki = RsaPublicKey::from_pem(SPKI_PUBLIC_PEM)
  let pkcs1 = RsaPublicKey::from_pem(PKCS1_PUBLIC_PEM)
  assert_true(spki.verify_sha256(message, signature))
  assert_true(pkcs1.verify_sha256(message, signature))
}

///|
test "rsa: a corrupted signature is rejected" {
  let public_key = RsaPublicKey::from_pem(SPKI_PUBLIC_PEM)
  let message = @utf8.encode(RSA_TEST_MESSAGE)
  let signature = decode_base64url(RSA_TEST_SIGNATURE_B64URL)
  let corrupted = signature.to_array()
  corrupted[0] = (corrupted[0].to_int() ^ 0x01).to_byte()
  let corrupted = Bytes::from_array(corrupted[:])
  assert_true(!public_key.verify_sha256(message, corrupted))
  assert_true(!public_key.verify_sha256(message, signature[:100]))
}

///|
test "rsa: public key can be derived from a private key" {
  let private_key = RsaPrivateKey::from_pem(PKCS8_PRIVATE_PEM)
  let public_key = private_key.public_key()
  let message = @utf8.encode(RSA_TEST_MESSAGE)
  assert_true(
    public_key.verify_sha256(message, private_key.sign_sha256(message)),
  )
}

///|
test "rsa: pem parsing tolerates CRLF and blank lines" {
  let crlf = SPKI_PUBLIC_PEM.replace_all(old="\n", new="\r\n")
  let public_key = RsaPublicKey::from_pem("\n" + crlf)
  assert_eq(public_key.modulus_bits(), 2048)
}

///|
test "rsa: malformed pem is rejected with InvalidKey" {
  let not_pem = try RsaPublicKey::from_pem("not a key") catch {
    InvalidKey(_) => true
    _ => false
  } noraise {
    _ => false
  }
  assert_true(not_pem)
  let truncated = try
    RsaPublicKey::from_pem(
      "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A\n-----END PUBLIC KEY-----",
    )
  catch {
    InvalidKey(_) => true
    _ => false
  } noraise {
    _ => false
  }
  assert_true(truncated)
}
