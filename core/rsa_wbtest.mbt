///|
/// SPKI public key (`openssl rsa -pubout`).
const SPKI_PUBLIC_PEM : String =
  #|-----BEGIN PUBLIC KEY-----
  #|MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAqcmrp+2H3lKzToMRhG4d
  #|csgKjbRpIva3IEXJlzGvFPF1YGP+F2BKgSQoTC2e0FueDbtWbPP6NCsa0dQ7IVbZ
